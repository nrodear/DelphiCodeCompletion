package dpcc.Core;

{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'dpcc Core (Logik des Plugins, ohne VCL und ToolsAPI)'}
{$RUNONLY}
{$IMPLICITBUILD ON}

// Laufzeit-Package mit der Logik des Plugins (seit S7b, vorher Teil von dpcc.IDE.Base): LSP-Sitzung,
// Completion-, Hover- und Signatur-Logik, Einstellungen, Sicherung und Diagnose. Erlaubt sind die RTL
// (System.*, Winapi.*) und die dpcc-Laufzeit-Packages; kein VCL, kein ToolsAPI, kein DesignIntf.
// Die Oberfläche liegt in dpcc.UI, die Anbindung an die IDE in dpcc.IDE.Base.

requires
  rtl,
  dpcc.Text,
  dpcc.WinBase,
  dpcc.Common,
  dpcc.Windows,
  dpcc.Server;

