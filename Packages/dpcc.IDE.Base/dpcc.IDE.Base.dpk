package dpcc.IDE.Base;

{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'dpcc (Code Insight-Manager)'}
{$DESIGNONLY}
{$IMPLICITBUILD OFF}
{$LIBSUFFIX AUTO}

// Design-Time-Package für RAD Studio: meldet dpcc als
// Code Insight-Manager für Delphi an und spricht über eine eigene LSP-Sitzung
// mit dem Server. Win32 für die klassische IDE, Win64 für die 64-Bit-IDE
// (#281). LIBSUFFIX AUTO hängt die Package-Version an
// (dpcc.IDE.Base290.bpl für Delphi 12, …370.bpl für Delphi 13), damit die
// BPLs beider IDE-Versionen nebeneinander liegen können.
// Seit Schritt 2b (Server im IDE-Prozess, docs\Konzept-Completion-Schnitt.md Abschnitt 4.5; seit S1 der einzige
// Betrieb, einen eigenen Server-Prozess gibt es nicht mehr) mit den Packages
// des Servers: dpcc.Text und dpcc.WinBase (früher hier als Quelltext mitübersetzt; eine Unit darf nur in
// einem geladenen Package stehen), dpcc.Common, dpcc.Windows und dpcc.Server. Die IDE lädt deren BPLs
// mit; sie müssen über PATH auffindbar sein (Output\$(Platform)\$(Config)\Bpl, siehe Konzept, Schritt 2b).

requires
  rtl,
  vcl,
  vclwinx,
  designide,
  dpcc.Text,
  dpcc.WinBase,
  dpcc.Common,
  dpcc.Windows,
  dpcc.Server;

contains
  dpcc.Core.Localization.Language in 'Source\Core\Localization\dpcc.Core.Localization.Language.pas',
  dpcc.Core.Lsp.Progress in 'Source\Core\Lsp\dpcc.Core.Lsp.Progress.pas',
