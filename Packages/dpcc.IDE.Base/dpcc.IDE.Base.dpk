package dpcc.IDE.Base;

{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'dpcc (Code Insight-Manager)'}
{$DESIGNONLY}
{$IMPLICITBUILD OFF}
{$LIBSUFFIX AUTO}

// Design-Time-Package für RAD Studio: meldet dpcc als
// Code Insight-Manager für Delphi an und spricht über eine eigene LSP-Sitzung
// mit dem Server. Win32 für die klassische IDE, Win64 für die 64-Bit-IDE
// (#281). LIBSUFFIX AUTO hängt die Package-Version an
// (dpcc.IDE.Base290.bpl für Delphi 12, …370.bpl für Delphi 13), damit die
// BPLs beider IDE-Versionen nebeneinander liegen können.
// Seit Schritt 2b (Server im IDE-Prozess, docs\Konzept-Completion-Schnitt.md Abschnitt 4.5; seit S1 der einzige
// Betrieb, einen eigenen Server-Prozess gibt es nicht mehr) mit den Packages
// des Servers: dpcc.Text und dpcc.WinBase (früher hier als Quelltext mitübersetzt; eine Unit darf nur in
// einem geladenen Package stehen), dpcc.Common, dpcc.Windows und dpcc.Server. Die IDE lädt deren BPLs
// mit; sie müssen über PATH auffindbar sein (Output\$(Platform)\$(Config)\Bpl, siehe Konzept, Schritt 2b).
// Seit S7b nur noch die Anbindung an die IDE (ToolsAPI, Registrierung): Die Logik liegt in dpcc.Core, die
// VCL-Oberfläche in dpcc.UI (beide Laufzeit-Packages, ebenfalls über PATH).

requires
  rtl,
  vcl,
  vclwinx,
  designide,
  dpcc.Text,
  dpcc.WinBase,
  dpcc.Common,
  dpcc.Windows,
  dpcc.Server,
  dpcc.Core,
  dpcc.UI;

contains
  dpcc.IDE.Foundation.EditorStyle in 'Source\IDE\Foundation\dpcc.IDE.Foundation.EditorStyle.pas',
  dpcc.IDE.Foundation.About in 'Source\IDE\Foundation\dpcc.IDE.Foundation.About.pas',
  dpcc.IDE.Foundation.EditorBuffer in 'Source\IDE\Foundation\dpcc.IDE.Foundation.EditorBuffer.pas',
  dpcc.IDE.Foundation.EditorSnapshot in 'Source\IDE\Foundation\dpcc.IDE.Foundation.EditorSnapshot.pas',
  dpcc.IDE.Foundation.EditorRefresh in 'Source\IDE\Foundation\dpcc.IDE.Foundation.EditorRefresh.pas',
  dpcc.IDE.Foundation.Files in 'Source\IDE\Foundation\dpcc.IDE.Foundation.Files.pas',
  dpcc.IDE.Foundation.Navigation in 'Source\IDE\Foundation\dpcc.IDE.Foundation.Navigation.pas',
  dpcc.IDE.Projects.Context in 'Source\IDE\Projects\dpcc.IDE.Projects.Context.pas',
  dpcc.IDE.Foundation.KeyHook in 'Source\IDE\Foundation\dpcc.IDE.Foundation.KeyHook.pas',
  dpcc.IDE.Foundation.LineTracker in 'Source\IDE\Foundation\dpcc.IDE.Foundation.LineTracker.pas',
  dpcc.IDE.Signature.Editor in 'Source\IDE\Signature\dpcc.IDE.Signature.Editor.pas',
  dpcc.IDE.Signature.FormatMarks in 'Source\IDE\Signature\dpcc.IDE.Signature.FormatMarks.pas',
  dpcc.IDE.Completion.Editor in 'Source\IDE\Completion\dpcc.IDE.Completion.Editor.pas',
  dpcc.IDE.Completion.EditorState in 'Source\IDE\Completion\dpcc.IDE.Completion.EditorState.pas',
  dpcc.IDE.Completion.EditorOpen in 'Source\IDE\Completion\dpcc.IDE.Completion.EditorOpen.pas',
  dpcc.IDE.Completion.EditorCommit in 'Source\IDE\Completion\dpcc.IDE.Completion.EditorCommit.pas',
  dpcc.IDE.CodeInsight.Manager.Paths in 'Source\IDE\CodeInsight\dpcc.IDE.CodeInsight.Manager.Paths.pas',
  dpcc.IDE.CodeInsight.Manager.Editors in 'Source\IDE\CodeInsight\dpcc.IDE.CodeInsight.Manager.Editors.pas',
  dpcc.IDE.CodeInsight.Manager.State in 'Source\IDE\CodeInsight\dpcc.IDE.CodeInsight.Manager.State.pas',
  dpcc.IDE.CodeInsight.Manager.Handlers in 'Source\IDE\CodeInsight\dpcc.IDE.CodeInsight.Manager.Handlers.pas',
  dpcc.IDE.CodeInsight.Manager.Session in 'Source\IDE\CodeInsight\dpcc.IDE.CodeInsight.Manager.Session.pas',
  dpcc.IDE.CodeInsight.IdeTypes in 'Source\IDE\CodeInsight\dpcc.IDE.CodeInsight.IdeTypes.pas',
  dpcc.IDE.CodeInsight.IdeMembers in 'Source\IDE\CodeInsight\dpcc.IDE.CodeInsight.IdeMembers.pas',
  dpcc.IDE.CodeInsight.Manager.Commands in 'Source\IDE\CodeInsight\dpcc.IDE.CodeInsight.Manager.Commands.pas',
  dpcc.IDE.CodeInsight.Manager.Crashes in 'Source\IDE\CodeInsight\dpcc.IDE.CodeInsight.Manager.Crashes.pas',
  dpcc.IDE.CodeInsight.Manager.Queries in 'Source\IDE\CodeInsight\dpcc.IDE.CodeInsight.Manager.Queries.pas',
  dpcc.IDE.CodeInsight.Manager in 'Source\IDE\CodeInsight\dpcc.IDE.CodeInsight.Manager.pas',
  dpcc.IDE.Foundation.Settings in 'Source\IDE\Foundation\dpcc.IDE.Foundation.Settings.pas',
  dpcc.IDE.Foundation.Host in 'Source\IDE\Foundation\dpcc.IDE.Foundation.Host.pas',
  dpcc.IDE.Settings.Options in 'Source\IDE\Settings\dpcc.IDE.Settings.Options.pas',
  dpcc.IDE.Settings.PageOptions in 'Source\IDE\Settings\dpcc.IDE.Settings.PageOptions.pas',
  dpcc.IDE.Completion.History in 'Source\IDE\Completion\dpcc.IDE.Completion.History.pas',
  dpcc.IDE.Completion.Favorites in 'Source\IDE\Completion\dpcc.IDE.Completion.Favorites.pas',
  dpcc.IDE.Completion.Adapters in 'Source\IDE\Completion\dpcc.IDE.Completion.Adapters.pas',
  dpcc.IDE.Completion.SaveNotifier in 'Source\IDE\Completion\dpcc.IDE.Completion.SaveNotifier.pas',
  dpcc.IDE.Foundation.Module in 'Source\IDE\Foundation\dpcc.IDE.Foundation.Module.pas',
  dpcc.IDE.Completion.Leftovers in 'Source\IDE\Completion\dpcc.IDE.Completion.Leftovers.pas',
  dpcc.IDE.Completion.Register in 'Source\IDE\Completion\dpcc.IDE.Completion.Register.pas',
  dpcc.IDE.Completion.Placeholders in 'Source\IDE\Completion\dpcc.IDE.Completion.Placeholders.pas',
  dpcc.IDE.Hover.DebugValue in 'Source\IDE\Hover\dpcc.IDE.Hover.DebugValue.pas',
  dpcc.IDE.Hover.Editor in 'Source\IDE\Hover\dpcc.IDE.Hover.Editor.pas',
  dpcc.IDE.Completion.Preview in 'Source\IDE\Completion\dpcc.IDE.Completion.Preview.pas',
  dpcc.IDE.Foundation.InsightSwitch in 'Source\IDE\Foundation\dpcc.IDE.Foundation.InsightSwitch.pas',
  dpcc.IDE.Forms.Designer in 'Source\IDE\Forms\dpcc.IDE.Forms.Designer.pas';

end.
