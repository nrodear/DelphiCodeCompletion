  dpcc.Core.Lsp.Session.Json in 'Source\Lsp\dpcc.Core.Lsp.Session.Json.pas',
  dpcc.Core.Lsp.Session.Base in 'Source\Lsp\dpcc.Core.Lsp.Session.Base.pas',
  dpcc.Core.Lsp.IdeTypes in 'Source\Lsp\dpcc.Core.Lsp.IdeTypes.pas',
  dpcc.Core.Lsp.IdeMembers in 'Source\Lsp\dpcc.Core.Lsp.IdeMembers.pas',
