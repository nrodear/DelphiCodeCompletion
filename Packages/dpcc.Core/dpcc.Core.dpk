  dpcc.Core.Lsp.Uris in 'Source\Lsp\dpcc.Core.Lsp.Uris.pas',
  dpcc.Core.Lsp.WorkspaceEdits in 'Source\Lsp\dpcc.Core.Lsp.WorkspaceEdits.pas',
  dpcc.Core.Lsp.Adapters.InProcess in 'Source\Lsp\dpcc.Core.Lsp.Adapters.InProcess.pas',
  dpcc.Core.Completion.Contract in 'Source\Completion\dpcc.Core.Completion.Contract.pas',
